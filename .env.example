# App config
PORT=4000
STAGE=dev
API_PREFIX=api
# Comma-separated origins allowed for CORS + CSRF
TRUSTED_ORIGINS=http://localhost:3000

# DB config
DB_URL=postgres://postgres:postgres@localhost:5432/auth
MAX_POOL=10
DB_TIMEZONE=UTC

# Auth config
AUTH_SESSION_ABSOLUTE_TTL=14d
AUTH_SESSION_IDLE_TTL=3d
API_KEY_PREFIX=dr
